# ── Usuario de test (Playwright) ─────────────────────────────────
# Único par de variables que el proyecto lee de .env (vía dotenv).
# Se usan en tests/smoke.spec.js para hacer login automático.
# Sin estas variables, el smoke test se salta (test.skip).
TEST_USER_EMAIL=tests@jamc.local
TEST_USER_PASSWORD=cambiar_por_la_clave_de_test
