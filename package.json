{
  "name": "jamcs-tech-dashboard",
  "private": true,
  "version": "2.4.0",
  "description": "JAMC's Tech terminal dashboard — Bloomberg-themed React/JSX dashboard apuntando a Supabase (sin build step en cliente; Babel-standalone). Para correrlo localmente usar `npm start`.",
  "scripts": {
    "start": "npx serve . -p 3000",
    "dev": "npx netlify dev",
    "test": "playwright test",
    "test:usuario": "playwright test tests/persona-usuario.spec.js",
    "test:qa": "playwright test tests/persona-qa.spec.js",
    "test:qaui": "playwright test tests/persona-qaui.spec.js",
    "test:tester": "playwright test tests/persona-tester.spec.js",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "netlify-cli": "^26.0.2"
  }
}
